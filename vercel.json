{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "functions": {
    "api/upload-receipt.js": { "memory": 256, "maxDuration": 30 },
    "api/list-receipts.js": { "memory": 256, "maxDuration": 15 }
  }
}
